
class Solution(object):
    def minOperations(self, nums):
        n = len(nums)
        zero = nums.index(0)
        ans = float('inf')

        def check(step):
            for i in range(n):
                idx = (zero + i * step) % n
                if nums[idx] != i:
                    return False
            return True

        if check(1):
            ans = min(ans, zero, n - zero + 2)

        if check(-1):
            ans = min(ans, zero + 2, n - zero)

        return -1 if ans == float('inf') else ans

class Solution(object):
    def countServers(self, n, logs, x, queries):
        """:type n: int :type logs: List[List[int]] :type x: int :type queries: List[int] :rtype: List[int]"""
        # Sort logs by time
        logs.sort(key=lambda item: item[1])
        
        # Pair each query with its original index so we can restore the order later
        m = len(queries)
        indexed_queries = sorted(enumerate(queries), key=lambda item: item[1])
        
        res = [0] * m
        server_count = {}
        
        i = 0
        l = len(logs)
        
        # Two pointers / sliding window for logs
        left = 0
        right = 0
        
        for orig_idx, q in indexed_queries:
            window_start = q - x
            window_end = q
            
            # Add logs that fall within or up to the window_end
            while right < l and logs[right][1] <= window_end:
                server_id = logs[right][0]
                server_count[server_id] = server_count.get(server_id, 0) + 1
                right += 1
                
            # Remove logs that fall outside the window to the left (older than window_start)
            while left < l and logs[left][1] < window_start:
                server_id = logs[left][0]
                server_count[server_id] -= 1
                if server_count[server_id] == 0:
                    del server_count[server_id]
                left += 1
                
            # Servers with zero requests = total servers (n) - servers with active requests in the window
            res[orig_idx] = n - len(server_count)
            
        return res


class Solution:
    def smallestUniqueSubarray(self, nums):
        n = len(nums)

        mod1 = 1000000007
        mod2 = 1000000009
        base = 911382323

        pow1 = [1] * (n + 1)
        pow2 = [1] * (n + 1)
        pre1 = [0] * (n + 1)
        pre2 = [0] * (n + 1)

        for i in range(n):
            pow1[i + 1] = pow1[i] * base % mod1
            pow2[i + 1] = pow2[i] * base % mod2

            pre1[i + 1] = (pre1[i] * base + nums[i]) % mod1
            pre2[i + 1] = (pre2[i] * base + nums[i]) % mod2

        def check(length):
            freq = {}

            for i in range(n - length + 1):
                h1 = (pre1[i + length] - pre1[i] * pow1[length]) % mod1
                h2 = (pre2[i + length] - pre2[i] * pow2[length]) % mod2

                key = (h1, h2)
                freq[key] = freq.get(key, 0) + 1

            return any(count == 1 for count in freq.values())

        left, right = 1, n
        ans = n

        while left <= right:
            mid = (left + right) // 2

            if check(mid):
                ans = mid
                right = mid - 1
            else:
                left = mid + 1

        return ans

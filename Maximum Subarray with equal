class Solution(object):
    def maxLength(self, nums):
        """
        :type nums: List[int]
        :rtype: int
        """
        def gcd(a, b):
            while b:
                a, b = b, a % b
            return a

        def lcm(a, b):
            return (a * b) // gcd(a, b)

        n = len(nums)
        ans = 1

        for i in range(n):
            prod = 1
            cur_gcd = 0
            cur_lcm = 1

            for j in range(i, n):
                x = nums[j]
                prod *= x
                cur_gcd = x if cur_gcd == 0 else gcd(cur_gcd, x)
                cur_lcm = lcm(cur_lcm, x)

                if prod == cur_lcm * cur_gcd:
                    ans = max(ans, j - i + 1)

        return ans


class Solution(object):
    def sortableIntegers(self, nums):
        """
        :type nums: List[int]
        :rtype: int
        """
        n = len(nums)
        ans = 0

        divisors = []
        for i in range(1, int(n ** 0.5) + 1):
            if n % i == 0:
                divisors.append(i)
                if i != n // i:
                    divisors.append(n // i)

        for k in divisors:
            possible = True
            prev_max = -1

            for start in range(0, n, k):
                end = start + k
                block = nums[start:end]

                mn = min(block)
                mx = max(block)

                if mn < prev_max:
                    possible = False
                    break

                drops = 0
                for j in range(k):
                    if block[j] > block[(j + 1) % k]:
                        drops += 1
                        if drops > 1:
                            break

                if drops > 1:
                    possible = False
                    break

                prev_max = mx

            if possible:
                ans += k

        return ans

class Solution(object):
    def minimumCost(self, cost1, cost2, costBoth, need1, need2):
        """
        :type cost1: int
        :type cost2: int
        :type costBoth: int
        :type need1: int
        :type need2: int
        :rtype: int
        """
        # Step 1: Satisfy the overlapping requirements using the cheapest option between 
        # buying an item of both types individually (cost1 + cost2) or a type 3 item (costBoth).
        common = min(need1, need2)
        effective_cost_both = min(costBoth, cost1 + cost2)
        total_cost = common * effective_cost_both
        
        # Update remaining needs
        need1 -= common
        need2 -= common
        
        # Step 2: Satisfy remaining type 1 requirement using the best of cost1 or costBoth
        if need1 > 0:
            total_cost += need1 * min(cost1, costBoth)
            
        # Step 3: Satisfy remaining type 2 requirement using the best of cost2 or costBoth
        if need2 > 0:
            total_cost += need2 * min(cost2, costBoth)
            
        return total_cost

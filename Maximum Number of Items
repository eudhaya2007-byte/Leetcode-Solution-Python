class Solution(object):
    def maximumSaleItems(self, items, budget):
        """
        :type items: List[List[int]]
        :type budget: int
        :rtype: int
        """
        if not items or budget <= 0:
            return 0

        max_factor = max(f for f, _ in items)

        
        freq = [0] * (max_factor + 1)
        for f, _ in items:
            freq[f] += 1

        divisible_items = [0] * (max_factor + 1)
        for d in range(1, max_factor + 1):
            total = 0
            for mult in range(d, max_factor + 1, d):
                total += freq[mult]
            divisible_items[d] = total

       
        dp = [0] * (budget + 1)

        for f, price in items:
            if price > budget:
                continue

           
            first_copy_gain = divisible_items[f]
            prev = dp[:]

           
            for b in range(price, budget + 1):
                if prev[b - price] + first_copy_gain > dp[b]:
                    dp[b] = prev[b - price] + first_copy_gain

           
            for b in range(price, budget + 1):
                if dp[b - price] + 1 > dp[b]:
                    dp[b] = dp[b - price] + 1

        return max(dp)

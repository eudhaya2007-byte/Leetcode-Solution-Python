
import heapq

class Solution(object):
    def maximumSaleItems(self, items, budget):
        n = len(items)

        mx = max(f for f, p in items)

        freq = [0] * (mx + 1)

        for f, p in items:
            freq[f] += 1

        extra = [0] * (mx + 1)

        for f in range(1, mx + 1):
            for j in range(f, mx + 1, f):
                extra[f] += freq[j]
            extra[f] -= 1

        heap = []

        for f, p in items:
            if extra[f] > 0:
                heapq.heappush(heap, (p, p, 2, extra[f]))
            else:
                heapq.heappush(heap, (2 * p, p, 1, 0))

        ans = 0

        while heap and budget > 0:
            key, price, value, count = heapq.heappop(heap)

            if value == 2:
                take = min(count, budget // price)

                ans += take * 2
                budget -= take * price

                if take == count:
                    heapq.heappush(
                        heap, (2 * price, price, 1, 0)
                    )

            else:
                take = budget // price

                if take == 0:
                    break

                ans += take
                budget -= take * price

        return ans

           

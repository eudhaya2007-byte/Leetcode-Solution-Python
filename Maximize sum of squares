
class Solution(object):
    def maxSumOfSquares(self, num, sum):
        if sum > 9 * num:
            return ""

        nines = sum // 9
        remainder = sum % 9

        result = "9" * nines

        if remainder > 0:
            result += str(remainder)

        result += "0" * (num - len(result))

        return result

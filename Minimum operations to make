import heapq

class WindowMedianCost:
    def __init__(self, nums, x):
        self.nums = nums
        self.x = x
        self.left = []   # max-heap (stored as negative)
        self.right = []  # min-heap
        self.sum_left = 0
        self.sum_right = 0
        self.removed_left = {}
        self.removed_right = {}
        self.size_left = 0
        self.size_right = 0

    def _add(self, val):
        if not self.left or val <= -self.left[0]:
            heapq.heappush(self.left, -val)
            self.sum_left += val
            self.size_left += 1
        else:
            heapq.heappush(self.right, val)
            self.sum_right += val
            self.size_right += 1
        self._balance()

    def _remove(self, val):
        if self.left and val <= -self.left[0]:
            self.removed_left[val] = self.removed_left.get(val, 0) + 1
            self.sum_left -= val
            self.size_left -= 1
        else:
            self.removed_right[val] = self.removed_right.get(val, 0) + 1
            self.sum_right -= val
            self.size_right -= 1
        self._balance()

    def _balance(self):
        while self.size_left > self.size_right + 1:
            val = -heapq.heappop(self.left)
            if self.removed_left.get(val, 0) > 0:
                self.removed_left[val] -= 1
            else:
                self.sum_left -= val
                self.size_left -= 1
                heapq.heappush(self.right, val)
                self.sum_right += val
                self.size_right += 1

        while self.size_right > self.size_left:
            val = heapq.heappop(self.right)
            if self.removed_right.get(val, 0) > 0:
                self.removed_right[val] -= 1
            else:
                self.sum_right -= val
                self.size_right -= 1
                heapq.heappush(self.left, -val)
                self.sum_left += val
                self.size_left += 1

        while self.left and self.removed_left.get(-self.left[0], 0) > 0:
            val = -heapq.heappop(self.left)
            self.removed_left[val] -= 1
        while self.right and self.removed_right.get(self.right[0], 0) > 0:
            val = heapq.heappop(self.right)
            self.removed_right[val] -= 1

    def get_cost(self):
        median = -self.left[0]
        return (median * self.size_left - self.sum_left) + (self.sum_right - median * self.size_right)


class Solution(object):
    def minOperations(self, nums, x, k):
        """:type nums: List[int]
        :type x: int
        :type k: int
        :rtype: int
        """
        n = len(nums)
        if k * x > n:
            return -1

        # Step 1: Precompute cost for each window of size x
        costs = [float('inf')] * (n - x + 1)
        wm = WindowMedianCost(nums, x)

        for i in range(x):
            wm._add(nums[i])
        costs[0] = wm.get_cost()

        for i in range(1, n - x + 1):
            wm._remove(nums[i - 1])
            wm._add(nums[i + x - 1])
            costs[i] = wm.get_cost()

        # Step 2: Dynamic Programming to select k non-overlapping windows
        # dp[j][i] = min operations using j windows up to index i
        inf = float('inf')
        prev_dp = [0] * (n + 1)
        
        for j in range(1, k + 1):
            curr_dp = [inf] * (n + 1)
            min_val = inf
            for i in range(1, n + 1):
                curr_dp[i] = curr_dp[i - 1]
                if i >= x:
                    # Option to take the window ending at i-1 (starting at i-x)
                    prev_cost = prev_dp[i - x]
                    if prev_cost != inf:
                        curr_dp[i] = min(curr_dp[i], prev_cost + costs[i - x])
            prev_dp = curr_dp

        return prev_dp[n] if prev_dp[n] != inf else -1

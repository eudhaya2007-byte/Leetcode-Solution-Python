class Solution(object):
    def scoreOfParentheses(self, s):
        stack = [0]

        for ch in s:
            if ch == '(':
                stack.append(0)
            else:
                v = stack.pop()

                if v == 0:
                    score = 1
                else:
                    score = 2 * v

                stack[-1] += score

        return stack[0]

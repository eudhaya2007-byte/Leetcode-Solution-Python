import heapq

class Solution(object):
    def shortestPath(self, n, edges, labels, k):
        """
        :type n: int
        :type edges: List[List[int]]
        :type labels: str
        :type k: int
        :rtype: int
        """
        # Build adjacency list: u -> list of (v, w)
        adj = [[] for _ in range(n)]
        for u, v, w in edges:
            adj[u].append((v, w))
            
        # Priority queue elements: (total_weight, current_node, consecutive_count)
        # Start at node 0 with its label having a count of 1
        pq = [(0, 0, 1)]
        
        # Distance dictionary to keep track of minimum weight to reach (node, count)
        dist = {}
        
        while pq:
            w, u, count = heapq.heappop(pq)
            
            # If we reached the destination node n - 1, return the total weight
            if u == n - 1:
                return w
                
            # If we have found a strictly better path to this state already, skip
            if (u, count) in dist and dist[(u, count)] < w:
                continue
            
            # Explore neighbors
            for v, weight in adj[u]:
                # If the label of the next node v is the same as the current node u, 
                # increment the streak. Otherwise, reset to 1.
                if labels[u] == labels[v]:
                    next_count = count + 1
                else:
                    next_count = 1
                    
                # Only proceed if the consecutive identical characters do not exceed k
                if next_count <= k:
                    next_w = w + weight
                    if (v, next_count) not in dist or next_w < dist[(v, next_count)]:
                        dist[(v, next_count)] = next_w
                        heapq.heappush(pq, (next_w, v, next_count))
                        
        return -1

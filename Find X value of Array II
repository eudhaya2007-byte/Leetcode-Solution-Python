class Solution(object):
    def resultArray(self, nums, k, queries):
        n = len(nums)

        # tree[node][r] = number of non-empty prefixes of this segment
        # whose product % k == r
        tree = [[0] * k for _ in range(4 * n)]

        # prod[node] = product of the whole segment modulo k
        prod = [1] * (4 * n)

        def merge(node, left, right):
            prod[node] = (prod[left] * prod[right]) % k

            for r in range(k):
                tree[node][r] = tree[left][r]

            # Prefixes that extend into the right child:
            # whole left segment + a prefix of right segment
            for r in range(k):
                nr = (prod[left] * r) % k
                tree[node][nr] += tree[right][r]

        def build(node, l, r):
            if l == r:
                p = nums[l] % k
                prod[node] = p
                tree[node][p] = 1
                return

            mid = (l + r) // 2

            build(node * 2, l, mid)
            build(node * 2 + 1, mid + 1, r)

            merge(node, node * 2, node * 2 + 1)

        def update(node, l, r, idx, val):
            if l == r:
                p = val % k
                prod[node] = p
                tree[node] = [0] * k
                tree[node][p] = 1
                return

            mid = (l + r) // 2

            if idx <= mid:
                update(node * 2, l, mid, idx, val)
            else:
                update(node * 2 + 1, mid + 1, r, idx, val)

            merge(node, node * 2, node * 2 + 1)

        # Returns (product modulo k, prefix-count array)
        def query(node, l, r, ql, qr):
            if ql <= l and r <= qr:
                return prod[node], tree[node][:]

            mid = (l + r) // 2

            if qr <= mid:
                return query(node * 2, l, mid, ql, qr)

            if ql > mid:
                return query(node * 2 + 1, mid + 1, r, ql, qr)

            lp, lc = query(node * 2, l, mid, ql, qr)
            rp, rc = query(node * 2 + 1, mid + 1, r, ql, qr)

            res = lc[:]

            # Prefixes that use part/all of left and continue into right
            for x in range(k):
                nr = (lp * x) % k
                res[nr] += rc[x]

            return (lp * rp) % k, res

        build(1, 0, n - 1)

        ans = []

        for index, value, start, x in queries:
            # Persistent update
            update(1, 0, n - 1, index, value)

            # We need products of:
            # nums[start],
            # nums[start] * nums[start+1],
            # ...
            # nums[start] * ... * nums[j]
            _, counts = query(1, 0, n - 1, start, n - 1)

            ans.append(counts[x])

        return ans

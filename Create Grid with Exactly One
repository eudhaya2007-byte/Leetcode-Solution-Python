class Solution(object):
    def createGrid(self, m, n):
        """
        :type m: int
        :type n: int
        :rtype: List[str]
        """
        grid = []
        for i in range(m):
            if i == 0:
               
                row = "." * n
            else:
                
                row = "#" * (n - 1) + "."
            grid.append(row)
        return grid

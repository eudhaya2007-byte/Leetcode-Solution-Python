
class Solution(object):
    def sumCounts(self, nums):
        """
        :type nums: List[int]
        :rtype: int
        """
        MOD = 10**9 + 7
        n = len(nums)

        tree = [0] * (4 * n)
        lazy = [0] * (4 * n)

        def apply(node, left, right, val):
            tree[node] = (
                tree[node] + (right - left + 1) * val
            ) % MOD
            lazy[node] = (lazy[node] + val) % MOD

        def push(node, left, right):
            if lazy[node] != 0 and left < right:
                mid = (left + right) // 2
                apply(node * 2, left, mid, lazy[node])
                apply(node * 2 + 1, mid + 1, right, lazy[node])
                lazy[node] = 0

        def update(node, left, right, ql, qr):
            if ql <= left and right <= qr:
                apply(node, left, right, 1)
                return

            push(node, left, right)
            mid = (left + right) // 2

            if ql <= mid:
                update(node * 2, left, mid, ql, qr)

            if qr > mid:
                update(node * 2 + 1, mid + 1, right, ql, qr)

            tree[node] = (
                tree[node * 2] + tree[node * 2 + 1]
            ) % MOD

        def query(node, left, right, ql, qr):
            if ql <= left and right <= qr:
                return tree[node]

            push(node, left, right)
            mid = (left + right) // 2
            result = 0

            if ql <= mid:
                result += query(
                    node * 2, left, mid, ql, qr
                )

            if qr > mid:
                result += query(
                    node * 2 + 1, mid + 1,
                    right, ql, qr
                )

            return result % MOD

        last = {}
        ans = 0
        current = 0

        for i, num in enumerate(nums):
            prev = last.get(num, -1)

            old_sum = query(
                1, 0, n - 1, prev + 1, i
            )

            length = i - prev

            current = (
                current + 2 * old_sum + length
            ) % MOD

            update(
                1, 0, n - 1, prev + 1, i
            )

            ans = (ans + current) % MOD
            last[num] = i

        return ans

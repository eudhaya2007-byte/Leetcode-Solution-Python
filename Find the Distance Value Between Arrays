import bisect

class Solution(object):
    def findTheDistanceValue(self, arr1, arr2, d):
        """
        :type arr1: List[int]
        :type arr2: List[int]
        :type d: int
        :rtype: int
        """
        arr2.sort()
        distance_value = 0
        
        for x in arr1:
            # Find the insertion point to keep arr2 sorted
            idx = bisect.bisect_left(arr2, x)
            
            # Check the closest element to the left
            left_valid = True
            if idx > 0:
                if abs(arr2[idx - 1] - x) <= d:
                    left_valid = False
            
            # Check the closest element to the right
            right_valid = True
            if idx < len(arr2):
                if abs(arr2[idx] - x) <= d:
                    right_valid = False
            
            # If both directions maintain a distance strictly greater than d
            if left_valid and right_valid:
                distance_value += 1
                
        return distance_value

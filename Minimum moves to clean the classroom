
from collections import deque

class Solution:
    def minMoves(self, classroom, energy):
        m = len(classroom)
        n = len(classroom[0])

        litter = []
        sr = sc = 0

        for r in range(m):
            for c in range(n):
                if classroom[r][c] == 'S':
                    sr, sc = r, c
                elif classroom[r][c] == 'L':
                    litter.append((r, c))

        k = len(litter)

        if k == 0:
            return 0

    
        litter_id = {}
        for i, pos in enumerate(litter):
            litter_id[pos] = i

        target = (1 << k) - 1

        
        q = deque()
        q.append((sr, sc, energy, 0))

    
        best = {(sr, sc, 0): energy}

        directions = [
            (-1, 0),
            (1, 0),
            (0, -1),
            (0, 1)
        ]

        moves = 0

        while q:
            for _ in range(len(q)):
                r, c, e, mask = q.popleft()

                if mask == target:
                    return moves

                for dr, dc in directions:
                    nr = r + dr
                    nc = c + dc

                    # Outside grid
                    if nr < 0 or nr >= m or nc < 0 or nc >= n:
                        continue

                    
                    if classroom[nr][nc] == 'X':
                        continue

                    
                    if e <= 0:
                        continue

                    ne = e - 1
                    nmask = mask

                    
                    if classroom[nr][nc] == 'L':
                        bit = litter_id[(nr, nc)]
                        nmask |= (1 << bit)

                
                    if classroom[nr][nc] == 'R':
                        ne = energy

                    key = (nr, nc, nmask)

                    if key in best and best[key] >= ne:
                        continue

                    best[key] = ne
                    q.append((nr, nc, ne, nmask))

            moves += 1

        return -1


class SegmentTree:

    def __init__(self, size):
        self.n = size
        self.tree = [0] * (4 * size)

    def build(self, node, start, end, init_vals):
        if start == end:
            self.tree[node] = init_vals[start]
            return
        mid = (start + end) // 2
        self.build(2 * node, start, mid, init_vals)
        self.build(2 * node + 1, mid + 1, end, init_vals)
        self.tree[node] = self.tree[2 * node] ^ self.tree[2 * node + 1]

    def update(self, node, start, end, idx, val):
        if start == end:
            self.tree[node] = val
            return
        mid = (start + end) // 2
        if start <= idx <= mid:
            self.update(2 * node, start, mid, idx, val)
        else:
            self.update(2 * node + 1, mid + 1, end, idx, val)
        self.tree[node] = self.tree[2 * node] ^ self.tree[2 * node + 1]

    def query(self, node, start, end, l, r):
        if r < start or end < l:
            return 0
        if l <= start and end <= r:
            return self.tree[node]
        mid = (start + end) // 2
        p1 = self.query(2 * node, start, mid, l, r)
        p2 = self.query(2 * node + 1, mid + 1, end, l, r)
        return p1 ^ p2


class Solution(object):

    def palindromePath(self, n, edges, s, queries):
        """:type n: int

        :type edges: List[List[int]]
        :type s: str
        :type queries: List[str]
        :rtype: List[bool]
        """
        import sys

        sys.setrecursionlimit(10**6)

        adj = [[] for _ in range(n)]
        for u, v in edges:
            adj[u].append(v)
            adj[v].append(u)

        parent = [0] * n
        depth = [0] * n
        heavy = [-1] * n
        head = [0] * n
        pos = [0] * n
        size = [0] * n
        cur_pos = [0]  # Use a list to avoid nonlocal issues

        def dfs1(u, p, d):
            size[u] = 1
            depth[u] = d
            parent[u] = p
            max_sub_size = 0
            for v in adj[u]:
                if v != p:
                    dfs1(v, u, d + 1)
                    size[u] += size[v]
                    if size[v] > max_sub_size:
                        max_sub_size = size[v]
                        heavy[u] = v

        dfs1(0, -1, 0)

        def dfs2(u, h):
            head[u] = h
            pos[u] = cur_pos[0]
            cur_pos[0] += 1

            if heavy[u] != -1:
                dfs2(heavy[u], h)

            for v in adj[u]:
                if v != parent[u] and v != heavy[u]:
                    dfs2(v, v)

        dfs2(0, 0)

        init_vals = [0] * n
        s_list = list(s)
        for i in range(n):
            init_vals[pos[i]] = 1 << (ord(s_list[i]) - ord('a'))

        seg = SegmentTree(n)
        seg.build(1, 0, n - 1, init_vals)

        def query_path(u, v):
            res = 0
            while head[u] != head[v]:
                if depth[head[u]] > depth[head[v]]:
                    u, v = v, u
                res ^= seg.query(1, 0, n - 1, pos[head[v]], pos[v])
                v = parent[head[v]]
            if depth[u] > depth[v]:
                u, v = v, u
            res ^= seg.query(1, 0, n - 1, pos[u], pos[v])
            return res

        ans = []
        for q in queries:
            parts = q.split()
            if parts[0] == 'update':
                u = int(parts[1])
                c = parts[2]
                s_list[u] = c
                new_val = 1 << (ord(c) - ord('a'))
                seg.update(1, 0, n - 1, pos[u], new_val)
            else:
                u = int(parts[1])
                v = int(parts[2])
                mask = query_path(u, v)
                if mask & (mask - 1) == 0:
                    ans.append(True)
                else:
                    ans.append(False)

        return ans

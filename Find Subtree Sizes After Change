class Solution(object):
    def findSubtreeSizes(self, parent, s):
        """
        :type parent: List[int]
        :type s: str
        :rtype: List[int]
        """
        n = len(parent)
        orig_children = [[] for _ in range(n)]
        for node in range(1, n):
            orig_children[parent[node]].append(node)

        new_parent = list(parent)
        last_seen = [-1] * 26

       
        def dfs_reparent(u):
            ch = ord(s[u]) - ord('a')
            prev_anc = last_seen[ch]
            if prev_anc != -1:
                new_parent[u] = prev_anc

            last_seen[ch] = u
            for v in orig_children[u]:
                dfs_reparent(v)
            last_seen[ch] = prev_anc

        dfs_reparent(0)

       
        new_children = [[] for _ in range(n)]
        for node in range(1, n):
            new_children[new_parent[node]].append(node)

        ans = [0] * n

        def dfs_size(u):
            size = 1
            for v in new_children[u]:
                size += dfs_size(v)
            ans[u] = size
            return size

        dfs_size(0)
        return ans  

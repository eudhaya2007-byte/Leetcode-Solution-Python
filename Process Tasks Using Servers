import heapq

class Solution(object):
    def assignTasks(self, servers, tasks):
        """
        :type servers: List[int]
        :type tasks: List[int]
        :rtype: List[int]
        """
        # Min-heap for free servers: sorted by (weight, index)
        free_servers = [(servers[i], i) for i in range(len(servers))]
        heapq.heapify(free_servers)
        
        # Min-heap for busy servers: sorted by (free_time, weight, index)
        busy_servers = []
        
        ans = []
        current_time = 0
        
        for j, task_time in enumerate(tasks):
            # Advance time to at least the current task's arrival time
            current_time = max(current_time, j)
            
            # If no servers are free, fast-forward time to when the next server frees up
            if not free_servers and busy_servers[0][0] > current_time:
                current_time = busy_servers[0][0]
            
            # Release all servers that have finished their tasks by current_time
            while busy_servers and busy_servers[0][0] <= current_time:
                _, weight, idx = heapq.heappop(busy_servers)
                heapq.heappush(free_servers, (weight, idx))
            
            # Assign the task to the optimal free server
            weight, idx = heapq.heappop(free_servers)
            ans.append(idx)
            
            # Push the server into the busy heap with its new free time
            heapq.heappush(busy_servers, (current_time + task_time, weight, idx))
            
        return ans

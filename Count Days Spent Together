class Solution(object):
    def countDaysTogether(self, arriveAlice, leaveAlice, arriveBob, leaveBob):
        """
        :type arriveAlice: str
        :type leaveAlice: str
        :type arriveBob: str
        :type leaveBob: str
        :rtype: int
        """
        # Days in each month for a non-leap year
        days_in_months = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
        
        # Helper function to convert "MM-DD" into an absolute day of the year (1 to 365)
        def date_to_days(date_str):
            month, day = map(int, date_str.split("-"))
            # Sum the days of all preceding months plus the days in the current month
            return sum(days_in_months[:month - 1]) + day

        # Convert all arrival and leaving dates to day numbers
        alice_arrive = date_to_days(arriveAlice)
        alice_leave = date_to_days(leaveAlice)
        bob_arrive = date_to_days(arriveBob)
        bob_leave = date_to_days(leaveBob)

        # The overlap interval starts at the later arrival date and ends at the earlier leaving date
        overlap_start = max(alice_arrive, bob_arrive)
        overlap_end = min(alice_leave, bob_leave)

        # Calculate the number of overlapping days (inclusive)
        # If overlap_start > overlap_end, they don't overlap, so we return 0
        return max(0, overlap_end - overlap_start + 1)
